# Copy to `.env` for local development. Never commit real secrets.
# See teamflow-documentation/docs/25-environment-variables.md for the full variable list.

NODE_ENV=
DATABASE_URL=
PORT=
# Base URL of the Express API for the web app, e.g. http://localhost:4000 (no trailing path)
NEXT_PUBLIC_API_URL=
# Optional server-side API override for Next.js middleware/server use.
# Falls back to NEXT_PUBLIC_API_URL when empty.
API_BASE_URL=

# Better Auth (API). Generate a secret locally with `pnpm dlx auth@latest secret`.
# Never commit real values.
BETTER_AUTH_SECRET=
# Base URL of the API, e.g. http://localhost:4000
BETTER_AUTH_URL=
# Comma-separated browser origins allowed credentialed API access, e.g. http://localhost:3000
# Empty = same-origin only. Shared by CORS middleware and Better Auth trusted origins.
CORS_ORIGIN=
