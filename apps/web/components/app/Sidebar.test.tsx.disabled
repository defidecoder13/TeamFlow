import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { beforeEach, describe, expect, it, vi } from 'vitest';
import type { WorkspaceChannelsState } from '../../lib/use-workspace-channels';
import type { DirectConversationsState } from '../../lib/use-direct-conversations';
import { Sidebar } from './Sidebar';
import type { Channel } from '../../lib/channels';
import type { DirectConversation } from '../../lib/messages';

const { channelsState, directConversationsState, pathname, pushMock } = vi.hoisted(() => ({
  channelsState: { value: { status: 'loading' } as WorkspaceChannelsState },
  directConversationsState: { value: { status: 'idle' } as DirectConversationsState },
  pathname: { value: '/app' },
  pushMock: vi.fn(),
}));

vi.mock('next/navigation', () => ({
  useRouter: () => ({ push: pushMock, replace: vi.fn(), refresh: vi.fn() }),
  usePathname: () => pathname.value,
}));

vi.mock('../../lib/use-workspace-channels', () => ({
  useWorkspaceChannels: () => ({
    state: channelsState.value,
    retry: vi.fn(),
    addChannel: vi.fn(),
    updateChannelState: vi.fn(),
  }),
}));

vi.mock('../../lib/use-direct-conversations', () => ({
  useDirectConversations: () => ({
    state: directConversationsState.value,
    retry: vi.fn(),
    addConversation: vi.fn(),
  }),
}));

const ENGINEERING: Channel = {
  id: 'ch-1',
  name: 'Engineering',
  slug: 'engineering',
  description: null,
  type: 'PUBLIC',
  createdAt: '2026-09-06T00:00:00.000Z',
  updatedAt: '2026-09-06T00:00:00.000Z',
};

const VAULT: Channel = {
  id: 'ch-2',
  name: 'Vault',
  slug: 'vault',
  description: null,
  type: 'PRIVATE',
  createdAt: '2026-09-06T00:00:00.000Z',
  updatedAt: '2026-09-06T00:00:00.000Z',
};

beforeEach(() => {
  pushMock.mockReset();
  pathname.value = '/app';
  channelsState.value = { status: 'loading' };
  directConversationsState.value = { status: 'idle' };
});

const DM_CONVERSATION: DirectConversation = {
  id: 'dm-1',
  workspaceId: 'ws-1',
  type: 'DIRECT',
  createdAt: new Date('2026-09-08T00:00:00.000Z'),
  updatedAt: new Date('2026-09-08T00:00:00.000Z'),
  participants: [
    { id: 'u-1', name: 'User One', email: 'user1@example.com', image: null },
    { id: 'u-2', name: 'Alan Turing', email: 'alan@example.com', image: null },
  ],
  peer: { id: 'u-2', name: 'Alan Turing', email: 'alan@example.com', image: null },
};

describe('Sidebar channels', () => {
  it('renders real channels with links and marks the URL-active one', () => {
    pathname.value = '/app/channels/vault';
    channelsState.value = { status: 'ready', channels: [ENGINEERING, VAULT] };
    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    const engineering = screen.getByRole('link', { name: 'Engineering' });
    expect(engineering).toHaveAttribute('href', '/app/channels/engineering');
    expect(engineering).not.toHaveAttribute('aria-current');

    const vault = screen.getByRole('link', { name: /^vault$/i });
    expect(vault).toHaveAttribute('href', '/app/channels/vault');
    expect(vault).toHaveAttribute('aria-current', 'page');
    expect(vault).toHaveAttribute('title', 'Vault (private)');
  });

  it('chunks long channel lists behind a Show-all toggle', async () => {
    const user = userEvent.setup();
    const many = Array.from({ length: 10 }, (_, i) => ({
      ...ENGINEERING,
      id: `ch-${i}`,
      name: `Channel ${i}`,
      slug: `channel-${i}`,
    }));
    channelsState.value = { status: 'ready', channels: many };
    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    expect(screen.getByRole('link', { name: 'Channel 0' })).toBeInTheDocument();
    expect(screen.queryByRole('link', { name: 'Channel 9' })).not.toBeInTheDocument();

    const toggle = screen.getByRole('button', { name: /show all 10 channels/i });
    expect(toggle).toHaveAttribute('aria-expanded', 'false');
    await user.click(toggle);
    expect(screen.getByRole('link', { name: 'Channel 9' })).toBeInTheDocument();
    expect(toggle).toHaveAttribute('aria-expanded', 'true');
  });

  it('never renders mock channels', () => {
    channelsState.value = { status: 'ready', channels: [ENGINEERING] };
    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    for (const mock of ['general', 'design', 'product', 'random']) {
      expect(
        screen.queryByRole('link', { name: new RegExp(`^${mock}$`, 'i') }),
      ).not.toBeInTheDocument();
    }
  });

  it('shows an honest empty state without a workspace', () => {
    channelsState.value = { status: 'idle' };
    render(<Sidebar workspaceName={null} workspaceId={null} />);

    expect(screen.getByText(/no channels yet/i)).toBeInTheDocument();
    expect(screen.queryByRole('button', { name: /create channel/i })).not.toBeInTheDocument();
  });

  it('opens the create dialog from the section action', async () => {
    const user = userEvent.setup();
    channelsState.value = { status: 'ready', channels: [] };
    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    await user.click(screen.getByRole('button', { name: /create channel/i }));

    expect(screen.getByRole('dialog', { name: /create a channel/i })).toBeInTheDocument();
  });

  it('marks only Home active on /app', () => {
    pathname.value = '/app';
    channelsState.value = { status: 'ready', channels: [ENGINEERING, VAULT] };
    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    const home = screen.getByRole('link', { name: 'Home' });
    expect(home).toHaveAttribute('href', '/app');
    expect(home).toHaveAttribute('aria-current', 'page');
    expect(screen.getByRole('link', { name: /^engineering$/i })).not.toHaveAttribute(
      'aria-current',
    );
  });

  it('marks only the matching channel active on /app/channels/demo', () => {
    pathname.value = '/app/channels/demo';
    channelsState.value = {
      status: 'ready',
      channels: [ENGINEERING, { ...VAULT, name: 'demo', slug: 'demo' }],
    };
    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    expect(screen.getByRole('link', { name: 'Home' })).not.toHaveAttribute('aria-current');
    const demo = screen.getByRole('link', { name: /^demo$/i });
    expect(demo).toHaveAttribute('aria-current', 'page');
    expect(screen.getByRole('link', { name: /^engineering$/i })).not.toHaveAttribute(
      'aria-current',
    );
  });
});

describe('Sidebar direct messages', () => {
  it('renders live direct message conversations and marks active URL', () => {
    pathname.value = '/app/dms/dm-1';
    directConversationsState.value = {
      status: 'ready',
      conversations: [DM_CONVERSATION],
    };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    const dmlink = screen.getByRole('link', { name: /alan turing/i });
    expect(dmlink).toHaveAttribute('href', '/app/dms/dm-1');
    expect(dmlink).toHaveAttribute('aria-current', 'page');
  });

  it('shows empty state when no direct messages exist', () => {
    directConversationsState.value = {
      status: 'ready',
      conversations: [],
    };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    expect(screen.getByText(/no messages yet/i)).toBeInTheDocument();
  });

  it('renders loading state for direct messages', () => {
    directConversationsState.value = { status: 'loading' };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    expect(screen.getByLabelText(/loading direct messages/i)).toBeInTheDocument();
  });

  it('opens StartDirectMessageDialog when clicking + button', async () => {
    const user = userEvent.setup();
    directConversationsState.value = { status: 'ready', conversations: [] };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    await user.click(screen.getByRole('button', { name: /start direct message/i }));

    expect(screen.getByRole('dialog', { name: /start direct message/i })).toBeInTheDocument();
  });

  it('renders unread badge and highlights conversation link when unreadCount > 0', () => {
    directConversationsState.value = {
      status: 'ready',
      conversations: [
        {
          ...DM_CONVERSATION,
          unreadCount: 3,
          hasUnread: true,
        },
      ],
    };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    const badge = screen.getByTestId('unread-badge-dm-1');
    expect(badge).toBeInTheDocument();
    expect(badge).toHaveTextContent('3');

    const link = screen.getByRole('link', { name: /alan turing/i });
    expect(link.className).toContain('font-semibold');
  });

  it('does not render unread badge when unreadCount is 0', () => {
    directConversationsState.value = {
      status: 'ready',
      conversations: [
        {
          ...DM_CONVERSATION,
          unreadCount: 0,
          hasUnread: false,
        },
      ],
    };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    expect(screen.queryByTestId('unread-badge-dm-1')).not.toBeInTheDocument();
  });

  it('renders a group conversation with custom name and participant count', () => {
    directConversationsState.value = {
      status: 'ready',
      conversations: [
        {
          id: 'grp-1',
          workspaceId: 'ws-1',
          type: 'GROUP',
          name: 'Core Architecture',
          participantCount: 4,
          unreadCount: 2,
          hasUnread: true,
          createdAt: new Date('2026-09-08T00:00:00.000Z'),
          updatedAt: new Date('2026-09-08T00:00:00.000Z'),
          participants: [],
        },
      ],
    };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    expect(screen.getByRole('link', { name: /core architecture/i })).toBeInTheDocument();
    expect(screen.getByText('4')).toBeInTheDocument();
    expect(screen.getByTestId('unread-badge-grp-1')).toHaveTextContent('2');
  });

  it('renders a group conversation with derived names when custom name is omitted', () => {
    directConversationsState.value = {
      status: 'ready',
      conversations: [
        {
          id: 'grp-2',
          workspaceId: 'ws-1',
          type: 'GROUP',
          name: null,
          participantCount: 3,
          unreadCount: 0,
          hasUnread: false,
          createdAt: new Date('2026-09-08T00:00:00.000Z'),
          updatedAt: new Date('2026-09-08T00:00:00.000Z'),
          participants: [
            { id: 'u-1', name: 'User One', email: 'user1@example.com', image: null },
            { id: 'u-2', name: 'Alan Turing', email: 'alan@example.com', image: null },
            { id: 'u-3', name: 'Grace Hopper', email: 'grace@example.com', image: null },
          ],
        },
      ],
    };

    render(<Sidebar workspaceName="Acme" workspaceId="ws-1" />);

    // Since currentUserId is u-1 from useSessionUserMock, it displays other participants: Alan Turing, Grace Hopper
    expect(screen.getByText(/alan turing, grace hopper/i)).toBeInTheDocument();
    expect(screen.getByText('3')).toBeInTheDocument();
  });
});
