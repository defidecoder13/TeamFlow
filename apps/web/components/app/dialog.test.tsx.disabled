import { fireEvent, render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { describe, expect, it, vi } from 'vitest';
import { Dialog, useMenuKeyboard } from './dialog';
import { useRef, useState } from 'react';

function OpenDialog({
  onClose = vi.fn(),
  dismissable,
}: {
  onClose?: () => void;
  dismissable?: boolean;
}) {
  return (
    <Dialog
      open
      onClose={onClose}
      labelledBy="test-title"
      describedBy="test-desc"
      dismissable={dismissable}
    >
      <h2 id="test-title">Test dialog</h2>
      <p id="test-desc">Description</p>
      <button type="button">First</button>
      <button type="button">Second</button>
    </Dialog>
  );
}

describe('Dialog', () => {
  it('renders nothing when closed', () => {
    render(
      <Dialog open={false} onClose={vi.fn()} labelledBy="t">
        <p>Hidden</p>
      </Dialog>,
    );
    expect(screen.queryByText('Hidden')).toBeNull();
  });

  it('marks page content inert while open and restores after', () => {
    const { unmount } = render(
      <div>
        <button type="button">Outside</button>
        <OpenDialog />
      </div>,
    );
    // `inert` applies to direct body children (the app root), never the
    // portal root the dialog itself renders into.
    expect(document.body.firstElementChild).toHaveAttribute('inert');
    expect(document.getElementById('teamflow-dialog-root')).not.toHaveAttribute('inert');
    unmount();
    expect(document.body.firstElementChild).not.toHaveAttribute('inert');
  });

  it('traps Tab inside the dialog', async () => {
    const user = userEvent.setup();
    render(<OpenDialog />);
    const first = screen.getByRole('button', { name: 'First' });
    const second = screen.getByRole('button', { name: 'Second' });
    expect(document.activeElement).toBe(first);

    await user.tab();
    expect(document.activeElement).toBe(second);
    // Wraps from last back to first.
    await user.tab();
    expect(document.activeElement).toBe(first);
    // Wraps backwards from first to last.
    await user.tab({ shift: true });
    expect(document.activeElement).toBe(second);
  });

  it('closes on Escape and restores focus to the trigger', async () => {
    const user = userEvent.setup();
    const onClose = vi.fn();
    function Harness() {
      const [open, setOpen] = useState(false);
      return (
        <div>
          <button type="button" onClick={() => setOpen(true)}>
            Trigger
          </button>
          <Dialog
            open={open}
            onClose={() => {
              onClose();
              setOpen(false);
            }}
            labelledBy="test-title"
          >
            <h2 id="test-title">Test dialog</h2>
            <button type="button">Inside</button>
          </Dialog>
        </div>
      );
    }
    render(<Harness />);
    const trigger = screen.getByRole('button', { name: 'Trigger' });
    await user.click(trigger);
    expect(screen.getByRole('button', { name: 'Inside' })).toBeInTheDocument();
    await user.keyboard('{Escape}');
    expect(onClose).toHaveBeenCalledTimes(1);
    expect(trigger).toHaveFocus();
  });

  it('does not close on Escape or backdrop when not dismissable', async () => {
    const user = userEvent.setup();
    const onClose = vi.fn();
    render(<OpenDialog onClose={onClose} dismissable={false} />);
    await user.keyboard('{Escape}');
    expect(onClose).not.toHaveBeenCalled();
  });
});

function OpenMenu({ onClose = vi.fn() }: { onClose?: () => void }) {
  const triggerRef = useRef<HTMLButtonElement>(null);
  const menuRef = useMenuKeyboard({ open: true, onClose, triggerRef });
  return (
    <div>
      <button type="button" ref={triggerRef}>
        Trigger
      </button>
      <div ref={menuRef} role="menu" aria-label="Test menu">
        <button type="button" role="menuitem">
          Alpha
        </button>
        <button type="button" role="menuitem">
          Beta
        </button>
      </div>
    </div>
  );
}

describe('useMenuKeyboard', () => {
  it('focuses the first item and moves with arrows, Home, End', () => {
    render(<OpenMenu />);
    expect(screen.getByRole('menuitem', { name: 'Alpha' })).toHaveFocus();
    fireEvent.keyDown(document.activeElement!, { key: 'ArrowDown' });
    expect(screen.getByRole('menuitem', { name: 'Beta' })).toHaveFocus();
    fireEvent.keyDown(document.activeElement!, { key: 'ArrowDown' });
    expect(screen.getByRole('menuitem', { name: 'Alpha' })).toHaveFocus();
    fireEvent.keyDown(document.activeElement!, { key: 'End' });
    expect(screen.getByRole('menuitem', { name: 'Beta' })).toHaveFocus();
    fireEvent.keyDown(document.activeElement!, { key: 'Home' });
    expect(screen.getByRole('menuitem', { name: 'Alpha' })).toHaveFocus();
  });

  it('closes on Escape and returns focus to the trigger', () => {
    const onClose = vi.fn();
    render(<OpenMenu onClose={onClose} />);
    fireEvent.keyDown(document.activeElement!, { key: 'Escape' });
    expect(onClose).toHaveBeenCalledTimes(1);
    expect(screen.getByRole('button', { name: 'Trigger' })).toHaveFocus();
  });
});
