import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { beforeEach, describe, expect, it, vi } from 'vitest';
import { WorkspaceHome } from './WorkspaceHome';

const { pushMock, replaceMock } = vi.hoisted(() => ({
  pushMock: vi.fn(),
  replaceMock: vi.fn(),
}));

vi.mock('next/navigation', () => ({
  useRouter: () => ({ push: pushMock, replace: replaceMock, refresh: vi.fn() }),
  usePathname: () => '/app',
}));

const USER = {
  id: 'user-1',
  name: 'Ada Lovelace',
  email: 'ada@example.com',
  image: null,
  emailVerified: true,
};

const WORKSPACE = { id: 'ws-1', name: 'Real Workspace' };

beforeEach(() => {
  pushMock.mockReset();
  replaceMock.mockReset();
});

describe('WorkspaceHome (Stitch reference)', () => {
  it('renders the overview row, greeting, cards, and honest empty activity', () => {
    render(<WorkspaceHome user={USER} workspace={WORKSPACE} />);

    expect(screen.getByText('Overview')).toBeInTheDocument();
    expect(
      screen.getByRole('heading', { name: /good (morning|afternoon|evening), ada/i }),
    ).toBeInTheDocument();
    expect(screen.getByText('Bring your team together')).toBeInTheDocument();
    expect(screen.getByText('Keep work organized')).toBeInTheDocument();
    expect(screen.getByText('Find work faster')).toBeInTheDocument();
    expect(screen.getByRole('heading', { name: 'Recent activity' })).toBeInTheDocument();
    expect(screen.getByText('Nothing here yet.')).toBeInTheDocument();
  });

  it('never renders fake activity, metrics, or Stitch demo content', () => {
    render(<WorkspaceHome user={USER} workspace={WORKSPACE} />);

    expect(screen.queryByText(/sarah chen|alex morgan|maya patel/i)).not.toBeInTheDocument();
    expect(screen.queryByText(/updated live/i)).not.toBeInTheDocument();
    expect(screen.queryByText(/create a space/i)).not.toBeInTheDocument();
    expect(document.body.textContent).not.toMatch(/%|analytics|productivity/i);
  });

  it('links Invite actions to members and Search to the real search route', () => {
    render(<WorkspaceHome user={USER} workspace={WORKSPACE} />);

    expect(screen.getByRole('link', { name: /invite your team/i })).toHaveAttribute(
      'href',
      '/app/settings/members',
    );
    expect(screen.getByRole('link', { name: /invite members/i })).toHaveAttribute(
      'href',
      '/app/settings/members',
    );
    expect(screen.getByRole('link', { name: /search workspace/i })).toHaveAttribute(
      'href',
      '/app/search',
    );
  });

  it('announces search with a link to the real search route', () => {
    render(<WorkspaceHome user={USER} workspace={WORKSPACE} />);
    expect(screen.getByRole('link', { name: /try permission-aware search/i })).toHaveAttribute(
      'href',
      '/app/search',
    );
  });

  it('opens the real channel creation dialog from all Create actions', async () => {
    const user = userEvent.setup();
    render(<WorkspaceHome user={USER} workspace={WORKSPACE} />);

    // Hero CTA, quick-start card, and the activity empty state each open it.
    const createButtons = screen.getAllByRole('button', { name: /create a channel/i });
    expect(createButtons).toHaveLength(3);

    await user.click(createButtons[0]!);

    expect(screen.getByRole('dialog', { name: /create a channel/i })).toBeInTheDocument();
  });
});
