/**
 * TopBar search integration tests: the search input submits to the real
 * /app/search route (with ?q= when a query is present) and the ⌘K/Ctrl+K
 * shortcut focuses it except from text inputs.
 */
import { fireEvent, render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { beforeEach, describe, expect, it, vi } from 'vitest';
import { TopBar } from './TopBar';

const { pushMock } = vi.hoisted(() => ({ pushMock: vi.fn() }));

vi.mock('next/navigation', () => ({
  useRouter: () => ({ push: pushMock, replace: vi.fn(), refresh: vi.fn() }),
}));

vi.mock('../../lib/auth-client', () => ({
  getAuthClient: () => ({ signOut: vi.fn() }),
}));

const USER = {
  id: 'u-1',
  name: 'Ada Lovelace',
  email: 'ada@example.com',
  image: null,
  emailVerified: true,
};

function renderBar() {
  render(<TopBar user={USER} workspaceName="Real Workspace" location="Search" />);
}

beforeEach(() => {
  pushMock.mockReset();
});

describe('TopBar search', () => {
  it('renders a search box that submits to the real search route', async () => {
    const user = userEvent.setup();
    renderBar();

    const box = screen.getByRole('searchbox', { name: 'Search' });
    await user.type(box, 'redis');
    await user.keyboard('{Enter}');

    expect(pushMock).toHaveBeenCalledWith('/app/search?q=redis');
  });

  it('navigates to bare search when submitted empty', async () => {
    const user = userEvent.setup();
    renderBar();

    await user.click(screen.getByRole('searchbox', { name: 'Search' }));
    await user.keyboard('{Enter}');

    expect(pushMock).toHaveBeenCalledWith('/app/search');
  });

  it('focuses the search box on ⌘K except from text inputs', () => {
    renderBar();
    const box = screen.getByRole('searchbox', { name: 'Search' });
    expect(document.activeElement).not.toBe(box);

    fireEvent.keyDown(window, { key: 'k', metaKey: true });
    expect(document.activeElement).toBe(box);
    expect(pushMock).not.toHaveBeenCalled();

    pushMock.mockReset();
    const input = document.createElement('input');
    document.body.appendChild(input);
    fireEvent.keyDown(input, { key: 'k', metaKey: true });
    expect(pushMock).not.toHaveBeenCalled();
    input.remove();

    (document.activeElement as HTMLElement | null)?.blur?.();
    fireEvent.keyDown(window, { key: 'k', ctrlKey: true });
    expect(document.activeElement).toBe(box);
  });

  it('renders a navigation menu button only when a menu handler is provided', async () => {
    const user = userEvent.setup();
    const onMenuClick = vi.fn();
    const { rerender } = render(
      <TopBar
        user={USER}
        workspaceName="Real Workspace"
        location="Search"
        onMenuClick={onMenuClick}
      />,
    );

    const menuButton = screen.getByRole('button', { name: 'Open navigation' });
    await user.click(menuButton);
    expect(onMenuClick).toHaveBeenCalledTimes(1);

    rerender(<TopBar user={USER} workspaceName="Real Workspace" location="Search" />);
    expect(screen.queryByRole('button', { name: 'Open navigation' })).not.toBeInTheDocument();
  });

  it('renders the notification bell and disables it when workspace is missing', () => {
    renderBar();
    const bell = screen.getByRole('button', { name: 'Notifications' });
    expect(bell).toBeInTheDocument();
    expect(bell).toBeDisabled();
  });

  it('renders the notification bell as enabled when workspaceId is provided', () => {
    render(
      <TopBar user={USER} workspaceName="Real Workspace" workspaceId="ws-1" location="Search" />,
    );
    const bell = screen.getByRole('button', { name: 'Notifications' });
    expect(bell).toBeInTheDocument();
    expect(bell).not.toBeDisabled();
    expect(bell).toHaveAttribute('aria-haspopup', 'dialog');
    expect(bell).toHaveAttribute('aria-expanded', 'false');
  });
});
