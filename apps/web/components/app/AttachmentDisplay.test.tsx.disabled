import { render, screen, waitFor, fireEvent } from '@testing-library/react';
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { AttachmentDisplay } from './AttachmentDisplay';
import * as attachmentsLib from '../../lib/attachments';

describe('AttachmentDisplay Component', () => {
  beforeEach(() => {
    vi.restoreAllMocks();
    attachmentsLib.clearAttachmentDownloadUrlCache();
  });

  it('renders nothing when attachments array is empty or undefined', () => {
    const { container: c1 } = render(<AttachmentDisplay attachments={[]} />);
    expect(c1.firstChild).toBeNull();

    const { container: c2 } = render(<AttachmentDisplay attachments={null} />);
    expect(c2.firstChild).toBeNull();
  });

  it('renders image attachment with preview when download URL fetch succeeds', async () => {
    vi.spyOn(attachmentsLib, 'fetchAttachmentDownloadUrl').mockResolvedValue({
      ok: true,
      url: 'https://r2.example.com/test-image.png',
    });

    const attachments = [
      {
        id: 'att-1',
        messageId: 'msg-1',
        originalName: 'screenshot.png',
        mimeType: 'image/png',
        size: 1024 * 50, // 50 KB
        createdAt: new Date(),
      },
    ];

    render(<AttachmentDisplay attachments={attachments} />);

    await waitFor(() => {
      const img = screen.getByRole('img', { name: 'screenshot.png' });
      expect(img).toBeDefined();
      expect(img.getAttribute('src')).toBe('https://r2.example.com/test-image.png');
    });

    expect(screen.getByText('screenshot.png')).toBeDefined();
    expect(screen.getByText('50.0 KB')).toBeDefined();
  });

  it('falls back to file card when image preview fails to load URL', async () => {
    vi.spyOn(attachmentsLib, 'fetchAttachmentDownloadUrl').mockResolvedValue({
      ok: false,
      error: 'File not found on storage',
    });

    const attachments = [
      {
        id: 'att-2',
        messageId: 'msg-1',
        originalName: 'broken-image.jpg',
        mimeType: 'image/jpeg',
        size: 1024 * 100, // 100 KB
        createdAt: new Date(),
      },
    ];

    render(<AttachmentDisplay attachments={attachments} />);

    await waitFor(() => {
      expect(screen.getByText('broken-image.jpg')).toBeDefined();
      expect(screen.getByText('File not found on storage')).toBeDefined();
    });
  });

  it('renders document attachment card and triggers download on click', async () => {
    const fetchSpy = vi.spyOn(attachmentsLib, 'fetchAttachmentDownloadUrl').mockResolvedValue({
      ok: true,
      url: 'https://r2.example.com/report.pdf',
    });

    const attachments = [
      {
        id: 'att-3',
        messageId: 'msg-1',
        originalName: 'report.pdf',
        mimeType: 'application/pdf',
        size: 1024 * 1024 * 2.5, // 2.5 MB
        createdAt: new Date(),
      },
    ];

    render(<AttachmentDisplay attachments={attachments} />);

    expect(screen.getByText('report.pdf')).toBeDefined();
    expect(screen.getByText('2.5 MB')).toBeDefined();

    const downloadBtn = screen.getByRole('button', { name: 'Download report.pdf' });
    expect(downloadBtn).toBeDefined();

    fireEvent.click(downloadBtn);

    await waitFor(() => {
      expect(fetchSpy).toHaveBeenCalledWith('att-3');
    });
  });

  describe('attachment deletion', () => {
    const fileAttachment = {
      id: 'att-del-1',
      messageId: 'msg-1',
      uploaderId: 'uploader-1',
      originalName: 'notes.txt',
      mimeType: 'text/plain',
      size: 512,
      createdAt: new Date(),
    };

    it('shows no delete control without identity or for unauthorized viewers', () => {
      const { rerender } = render(<AttachmentDisplay attachments={[fileAttachment]} />);
      expect(screen.queryByRole('button', { name: /delete notes\.txt/i })).toBeNull();

      rerender(
        <AttachmentDisplay
          attachments={[fileAttachment]}
          currentUserId="stranger"
          messageAuthorId="author-1"
        />,
      );
      expect(screen.queryByRole('button', { name: /delete notes\.txt/i })).toBeNull();
    });

    it('shows delete for the message author and removes the item after confirm', async () => {
      const deleteSpy = vi
        .spyOn(attachmentsLib, 'deleteAttachment')
        .mockResolvedValue({ ok: true });

      render(
        <AttachmentDisplay
          attachments={[fileAttachment]}
          currentUserId="author-1"
          messageAuthorId="author-1"
        />,
      );

      // Two-step confirm: first click arms, second click deletes.
      fireEvent.click(screen.getByRole('button', { name: 'Delete notes.txt' }));
      expect(screen.getByText('Delete?')).toBeDefined();
      expect(screen.getByRole('button', { name: 'Confirm delete notes.txt' })).toBeDefined();

      fireEvent.click(screen.getByRole('button', { name: 'Confirm delete notes.txt' }));

      await waitFor(() => {
        expect(deleteSpy).toHaveBeenCalledWith('att-del-1');
      });
      await waitFor(() => {
        expect(screen.queryByText('notes.txt')).toBeNull();
      });
    });

    it('shows delete for the uploader even when they did not author the message', () => {
      vi.spyOn(attachmentsLib, 'deleteAttachment').mockResolvedValue({ ok: true });

      render(
        <AttachmentDisplay
          attachments={[fileAttachment]}
          currentUserId="uploader-1"
          messageAuthorId="author-1"
        />,
      );

      expect(screen.getByRole('button', { name: 'Delete notes.txt' })).toBeDefined();
    });

    it('keeps the attachment and shows an error when deletion fails', async () => {
      vi.spyOn(attachmentsLib, 'deleteAttachment').mockResolvedValue({
        ok: false,
        error: 'You do not have permission to delete this attachment.',
      });

      render(
        <AttachmentDisplay
          attachments={[fileAttachment]}
          currentUserId="author-1"
          messageAuthorId="author-1"
        />,
      );

      fireEvent.click(screen.getByRole('button', { name: 'Delete notes.txt' }));
      fireEvent.click(screen.getByRole('button', { name: 'Confirm delete notes.txt' }));

      await waitFor(() => {
        expect(
          screen.getByText('You do not have permission to delete this attachment.'),
        ).toBeDefined();
      });
      // Item stays in place; failure never corrupts message state.
      expect(screen.getByText('notes.txt')).toBeDefined();
    });
  });
});
