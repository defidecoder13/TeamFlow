{
  "name": "@teamflow/db",
  "version": "0.0.0",
  "private": true,
  "description": "TeamFlow database infrastructure (Prisma + PostgreSQL)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "postinstall": "prisma generate && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "@teamflow/config": "workspace:*",
    "prisma": "^6.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
